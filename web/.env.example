# Supabase project (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret key (payment webhooks). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public site URL (OAuth redirects, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: map tile server (defaults to OpenStreetMap; use a commercial provider in production)
NEXT_PUBLIC_MAP_TILE_URL=
