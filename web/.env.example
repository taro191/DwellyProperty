# MySQL 8.0+ (utf8mb4). Create the database first, then: npm run db:migrate
DATABASE_URL=mysql://dwelly:password@127.0.0.1:3306/dwelly

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public site URL (OAuth callbacks, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social login (optional — buttons appear only when set)
# Google: https://console.cloud.google.com  callback: {SITE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LINE Login: https://developers.line.biz  callback: {SITE_URL}/api/auth/callback/line
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Email (OTP codes). Without SMTP, codes are printed to the server log (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Dwelly <no-reply@your-domain>

# Uploaded files live on disk here (outside public/ — include in backups)
STORAGE_DIR=./storage

# Protects POST /api/cron/maintenance (if you use HTTP cron instead of `npm run maintenance`)
CRON_SECRET=

# Optional: map tiles (default OpenStreetMap; use a commercial provider in production)
NEXT_PUBLIC_MAP_TILE_URL=
